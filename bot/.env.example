# Clave de API de Composio (dashboard.composio.dev -> Settings -> API Keys)
COMPOSIO_API_KEY=

# Clave de API de Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# ID de usuario/entidad en Composio. Dejalo en "default" salvo que hayas
# conectado la cuenta de Instagram bajo otro nombre de entidad.
COMPOSIO_USER_ID=default

# Cada cuántos milisegundos revisa si hay mensajes nuevos (20000 = 20s)
POLL_INTERVAL_MS=20000

# Datos que el asistente puede mencionar en la conversación
WEBSITE_URL=https://synergy-solutions-six.vercel.app/
WHATSAPP_NUMBER=5491128981201

# A dónde te llega el aviso por mail cuando entra un mensaje nuevo
ALERT_EMAIL=uricherno@gmail.com
